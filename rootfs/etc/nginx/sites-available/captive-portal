# Other common general checks
server {
    listen 80;
    server_name neverssl.com example.com; # often used by users to trigger a portal if automatic detection fails
    return 302 http://10.42.42.251/index.php;
}

# For devices that might probe other common sites
server {
    listen 80;
    server_name www.google.com www.bing.com; # Some devices might try to access these first.
    return 302 http://10.42.42.251/index.php;
}

# ConnMan (Linux network connection manager)
server {
    listen 80;
    server_name ipv4.connman.net;
    return 302 http://10.42.42.251/index.php;
}

server {
        listen 10.42.42.251:80;
        root /var/www/dashboard;

	try_files $uri $uri/ /index.php;

        location ^~ /admin {
		deny	10.42.42.251;
		allow	10.42.42.0/24;
		deny	all;
		try_files $uri $uri/ =404;
		client_max_body_size 512K;

	# Load the defaults
	include             /etc/nginx/default.d/php.conf;
	}

	location ~ /\.git {
		deny all;
	}

	# Load the defaults
	include             /etc/nginx/default.d/*.conf;
}
