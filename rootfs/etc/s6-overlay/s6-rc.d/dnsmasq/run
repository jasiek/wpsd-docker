#!/command/with-contenv bash
if [ "${WPSD_ENABLE_DNSMASQ:-0}" != "1" ]; then
    echo "dnsmasq: disabled (WPSD_ENABLE_DNSMASQ != 1)" >&2
    /command/s6-svc -d /run/service/dnsmasq
    exec /command/s6-pause
fi
# Only meaningful in AP mode, which needs --net=host and NET_ADMIN.
exec /usr/sbin/dnsmasq --keep-in-foreground --log-facility=-
